{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/farrelfauzan/opportunity-radar/docs/opportunities/output.schema.json",
  "title": "Opportunity (LLM output contract v1, OR-11)",
  "description": "Shape only. Code rules are checked after this schema: cited ids must be in the input set, at least 2 distinct citations, no blank text after trimming, sector ids from the fixed list, theme not 'other'.",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "thesis", "region", "theme", "sectors", "horizon", "capital", "buyer", "model", "risks", "firstSteps", "factors", "citations"],
  "$defs": {
    "text": {
      "type": "object", "additionalProperties": false, "required": ["en", "id"],
      "properties": { "en": { "type": "string", "minLength": 1 }, "id": { "type": "string", "minLength": 1 } }
    },
    "text90": { "allOf": [{ "$ref": "#/$defs/text" }], "properties": { "en": { "maxLength": 90 }, "id": { "maxLength": 90 } } },
    "text120": { "allOf": [{ "$ref": "#/$defs/text" }], "properties": { "en": { "maxLength": 120 }, "id": { "maxLength": 120 } } },
    "text160": { "allOf": [{ "$ref": "#/$defs/text" }], "properties": { "en": { "maxLength": 160 }, "id": { "maxLength": 160 } } },
    "text200": { "allOf": [{ "$ref": "#/$defs/text" }], "properties": { "en": { "maxLength": 200 }, "id": { "maxLength": 200 } } },
    "text400": { "allOf": [{ "$ref": "#/$defs/text" }], "properties": { "en": { "maxLength": 400 }, "id": { "maxLength": 400 } } },
    "factor": {
      "type": "object", "additionalProperties": false, "required": ["score", "reason"],
      "properties": { "score": { "type": "integer", "minimum": 0, "maximum": 100 }, "reason": { "$ref": "#/$defs/text200" } }
    }
  },
  "properties": {
    "title": { "$ref": "#/$defs/text90" },
    "thesis": { "$ref": "#/$defs/text400" },
    "region": { "enum": ["indonesia", "worldwide"] },
    "theme": { "type": "string", "pattern": "^[a-z_]+$" },
    "sectors": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z_]+$" } },
    "horizon": { "enum": ["0-6m", "6-12m", "1-3y"] },
    "capital": {
      "type": "object", "additionalProperties": false, "required": ["level", "reason"],
      "properties": { "level": { "enum": ["low", "medium", "high"] }, "reason": { "$ref": "#/$defs/text120" } }
    },
    "buyer": { "$ref": "#/$defs/text120" },
    "model": { "$ref": "#/$defs/text120" },
    "risks": { "type": "array", "minItems": 2, "maxItems": 5, "items": { "$ref": "#/$defs/text160" } },
    "firstSteps": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "$ref": "#/$defs/text160" } },
    "factors": {
      "type": "object", "additionalProperties": false,
      "required": ["demand", "timing", "competition", "capital", "regulatory"],
      "properties": {
        "demand": { "$ref": "#/$defs/factor" }, "timing": { "$ref": "#/$defs/factor" }, "competition": { "$ref": "#/$defs/factor" },
        "capital": { "$ref": "#/$defs/factor" }, "regulatory": { "$ref": "#/$defs/factor" }
      }
    },
    "citations": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } }
  }
}
