# Variable names only, never values. Real values go in .env.local (git-ignored).
# `pnpm db:setup` writes .env.local with the local docker compose defaults.

# Development database (postgres:// URL). Read on the server only.
DATABASE_URL=
# Test database used by `pnpm test`, `pnpm db:reset` and QA. Its name must end in "_test".
TEST_DATABASE_URL=

# LLM (OR-13). Mock unless LLM_PROVIDER=live: the mock answers in-process, nothing leaves the machine.
LLM_PROVIDER=
# OpenAI-compatible endpoint (9router), its key and the two models. Needed only for live.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_TRIAGE=
LLM_MODEL_REPORT=
# Prices in USD per 1M tokens, per role; without them the cost is recorded as unknown.
LLM_PRICE_TRIAGE_IN=
LLM_PRICE_TRIAGE_OUT=
LLM_PRICE_REPORT_IN=
LLM_PRICE_REPORT_OUT=
# Monthly cap (WIB calendar month). Live calls need the USD budget with prices, or the token cap.
LLM_MONTHLY_BUDGET_USD=
LLM_MONTHLY_TOKEN_CAP=

# Triage (OR-14): articles below this relevance (0-100) are kept but not used for opportunities. Default 30.
TRIAGE_MIN_RELEVANCE=

# Prices (OR-26). Yahoo: "fixtures" (default; synthetic, not market data) or "live" (decision D9, OR-53).
PRICES_YAHOO=
# Frankfurter USD/IDR: "live" (default) or "fixtures" (recorded history, for tests).
PRICES_FRANKFURTER=
# Metals (OR-27), gold-api.com spot: "fixtures" (default; synthetic) or "live" (OR-54).
PRICES_GOLDAPI=
# Crypto (OR-27), Binance data-api.binance.vision and Indodax: "live" (default) or "fixtures" (synthetic, for tests).
PRICES_CRYPTO=
