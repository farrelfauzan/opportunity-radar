{
  "name": "opportunity-radar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose stop",
    "db:setup": "docker compose up -d --wait && node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db.ts setup",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db.ts migrate",
    "db:seed": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db.ts seed",
    "db:reset": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db.ts reset",
    "db:set-last-run": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db.ts set-last-run",
    "job": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/node-hooks.mjs scripts/job.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "0.45.3",
    "lucide-react": "^1.51.0",
    "next": "16.3.8",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.8.0",
    "server-only": "0.0.1",
    "shadcn": "^4.21.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@10.26.2"
}
